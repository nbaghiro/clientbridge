# Plain HTTP on :8080 (TLS ends at the Gateway); hosts and URLs come from the image's serve script.
{
	admin off
	auto_https off
	persist_config off
}

(cache) {
	@hashed path /assets/*
	@unhashed not path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header @unhashed Cache-Control "no-cache"
}

(unframed) {
	header Content-Security-Policy "frame-ancestors 'none'"
	header X-Frame-Options DENY
}

(spa) {
	root * /srv/{args[0]}
	import cache
	@asset path /assets/*
	handle @asset {
		file_server
	}
	handle {
		try_files {path} /index.html
		file_server
	}
}

:8080 {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	@associations {
		host {$APP_HOST}
		path /.well-known/apple-app-site-association /.well-known/assetlinks.json
	}
	@site host {$SITE_HOST}
	@admin host {$ADMIN_HOST}
	@app host {$APP_HOST}
	@connect host {$BOOK_HOST} {$PAY_HOST} {$SHOP_HOST}

	handle /config.js {
		header Content-Type "text/javascript; charset=utf-8"
		header Cache-Control "no-cache"
		respond `window.__CLIENTBRIDGE_CONFIG__ = {"baseDomain":"{$BASE_DOMAIN}","webUrl":"{$APP_URL}","adminUrl":"{$ADMIN_URL}","apiUrl":"{$API_URL}","authUrl":"{$AUTH_URL}","syncUrl":"{$SYNC_URL}","payUrl":"{$PAY_URL}","bookUrl":"{$BOOK_URL}","stripePublishableKey":"{$STRIPE_PUBLISHABLE_KEY}"};
`
	}

	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "no-cache"
		@indexable {
			host {$SITE_HOST}
			expression `"{$ENVIRONMENT}" == "production"`
		}
		respond @indexable "User-agent: *
Allow: /

Sitemap: {$SITE_URL}/sitemap.xml
"
		respond "User-agent: *
Disallow: /
"
	}

	handle @associations {
		header Content-Type application/json
		header Cache-Control "public, max-age=3600"
		root * /tmp/well-known
		uri strip_prefix /.well-known
		file_server
	}

	handle @site {
		@contact {
			method POST
			path /contact
		}
		handle @contact {
			reverse_proxy {$CONTACT_UPSTREAM}
		}
		import unframed
		import cache
		root * /tmp/site
		@missing not file {path}/index.html {path}
		handle @missing {
			rewrite * /404.html
			file_server {
				status 404
			}
		}
		handle {
			try_files {path}/index.html {path}
			file_server
		}
	}

	handle @admin {
		import unframed
		import spa admin
	}

	handle @app {
		import unframed
		import spa web
	}

	# Businesses frame the widgets public/embed.js loads; every other Connect page stays unframed.
	handle @connect {
		@unembeddable not path /b/* /i/* /form/* /contract/*
		header @unembeddable Content-Security-Policy "frame-ancestors 'none'"
		header @unembeddable X-Frame-Options DENY
		import spa connect
	}

	handle {
		respond 404
	}
}
