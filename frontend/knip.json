{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "workspaces": {
        "apps/web": {
            "entry": [
                "scripts/service-worker.js",
                "playwright.config.ts",
                "playwright.journeys.config.ts",
                "playwright.filings.config.ts",
                "e2e/**/*.e2e.ts",
                "e2e/**/*.journey.ts",
                "e2e/**/*.filing.ts"
            ],
            "playwright": false
        },
        "apps/connect": {
            "entry": [
                "public/embed.js",
                "src/embedLoader.ts",
                "playwright.config.ts",
                "playwright.stripe.config.ts",
                "playwright.smoke.config.ts",
                "e2e/**/*.e2e.ts",
                "e2e/**/*.spec.ts",
                "e2e/smoke/*.smoke.ts"
            ],
            "playwright": false
        },
        "apps/site": {
            "entry": ["src/entry-server.tsx", "scripts/*.ts"]
        },
        "apps/mobile": {
            "entry": ["e2e/helpers/*.js"],
            "ignoreDependencies": ["@babel/core", "expo-updates"]
        },
        "packages/app-core": {
            "ignoreDependencies": ["@powersync/react"]
        },
        "packages/tokens": {
            "entry": ["scripts/*.cjs"]
        },
        "packages/config": {
            "entry": ["scripts/*.mjs", "*.test.mjs"]
        },
        "packages/sync": {
            "playwright": false,
            "entry": ["playwright.config.ts", "e2e/**/*.e2e.ts"]
        }
    },
    "ignore": ["packages/api-client/src/generated.ts"]
}
