{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "workspaces": {
        "apps/web": {
            "ignoreDependencies": ["@journeyapps/wa-sqlite"],
            "entry": ["scripts/service-worker.js"],
            "playwright": {
                "config": [
                    "playwright.config.ts",
                    "playwright.journeys.config.ts",
                    "playwright.filings.config.ts"
                ]
            }
        },
        "apps/connect": {
            "entry": ["public/embed.js", "src/embedLoader.ts"],
            "playwright": {
                "config": ["playwright.config.ts", "playwright.stripe.config.ts"]
            }
        },
        "apps/site": {
            "entry": ["src/entry-server.tsx", "scripts/*.ts"]
        },
        "apps/mobile": {
            "entry": ["e2e/helpers/*.js"],
            "ignoreBinaries": ["maestro"],
            "ignoreDependencies": ["@babel/core", "expo-updates"]
        },
        "packages/app-core": {
            "ignoreDependencies": ["@powersync/react"]
        },
        "packages/tokens": {
            "entry": ["scripts/*.cjs"]
        },
        "packages/config": {
            "entry": ["scripts/*.mjs", "*.test.mjs"]
        }
    },
    "ignore": ["packages/api-client/src/generated.ts"]
}
