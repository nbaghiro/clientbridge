# Release builds set BASE_DOMAIN (clientbridge.ca or staging.clientbridge.ca) instead of the URLs.
BASE_DOMAIN=
API_URL=http://localhost:8701
POWERSYNC_URL=http://localhost:8704
AUTH_URL=http://localhost:8713
PUBLIC_WEB_URL=http://localhost:8700
# Platform publishable key (pk_test_/pk_live_); never a secret key.
STRIPE_PUBLISHABLE_KEY=
STRIPE_MERCHANT_ID=merchant.ca.clientbridge.app
STRIPE_TERMINAL_SIMULATED=true
