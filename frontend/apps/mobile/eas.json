{
    "cli": {
        "version": ">= 16.0.0",
        "appVersionSource": "remote"
    },
    "build": {
        "staging": {
            "environment": "preview",
            "channel": "staging",
            "autoIncrement": true,
            "ios": { "distribution": "store" },
            "android": { "distribution": "internal", "buildType": "apk" }
        },
        "production": {
            "environment": "production",
            "channel": "production",
            "distribution": "store",
            "autoIncrement": true
        }
    },
    "submit": {
        "staging": {
            "ios": { "bundleIdentifier": "ca.clientbridge.app.staging" }
        },
        "production": {
            "ios": { "bundleIdentifier": "ca.clientbridge.app" },
            "android": { "track": "internal", "releaseStatus": "draft" }
        }
    }
}
