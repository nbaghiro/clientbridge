# Where the marketing site links out to. Defaults are the local dev servers.
VITE_SITE_URL=http://localhost:8710
VITE_APP_URL=http://localhost:8700
VITE_PAGE_URL=http://{slug}.localhost:8709
# 1 builds the pre-launch site: the waitlist replaces sign-up, sign-in and the demo
VITE_WAITLIST=
# Set only by the e2e runner: its namespace, which ends each seeded demo business's slug
VITE_DEMO_NAMESPACE=
