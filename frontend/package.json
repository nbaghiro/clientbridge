{
    "name": "clientbridge-frontend",
    "private": true,
    "packageManager": "pnpm@9.7.0",
    "prettier": "@clientbridge/config/prettier",
    "scripts": {
        "dev": "turbo run dev",
        "build": "turbo run build",
        "lint": "eslint . && node packages/config/scripts/check-structure.mjs",
        "typecheck": "turbo run typecheck",
        "format": "prettier --write \"**/*.{ts,tsx,css,md,json}\"",
        "format:check": "prettier --check \"**/*.{ts,tsx,css,md,json}\"",
        "test": "turbo run test"
    },
    "devDependencies": {
        "@clientbridge/config": "workspace:*",
        "eslint": "^10.12.0",
        "prettier": "^3.9.9",
        "turbo": "^2.11.7",
        "typescript": "^6.0.3"
    }
}
