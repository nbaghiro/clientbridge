{
    "name": "@clientbridge/ui",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "main": "./src/web/index.ts",
    "react-native": "./src/mobile/index.ts",
    "sideEffects": false,
    "exports": {
        ".": {
            "react-native": "./src/mobile/index.ts",
            "default": "./src/web/index.ts"
        },
        "./logo": "./src/web/Logo.tsx"
    },
    "scripts": {
        "typecheck": "tsc --noEmit -p src/web && tsc --noEmit -p src/mobile"
    },
    "dependencies": {
        "@clientbridge/tokens": "workspace:*"
    },
    "peerDependencies": {
        "@clientbridge/app-core": "workspace:*",
        "@stripe/react-stripe-js": "^7.0.0",
        "@stripe/stripe-js": "^10.0.0",
        "react": ">=19",
        "@stripe/stripe-react-native": "*",
        "react-native": "*",
        "react-native-svg": "*"
    },
    "peerDependenciesMeta": {
        "@stripe/react-stripe-js": {
            "optional": true
        },
        "@stripe/stripe-js": {
            "optional": true
        },
        "@stripe/stripe-react-native": {
            "optional": true
        },
        "react-native": {
            "optional": true
        },
        "react-native-svg": {
            "optional": true
        }
    },
    "devDependencies": {
        "@clientbridge/app-core": "workspace:*",
        "@stripe/react-stripe-js": "^7.0.0",
        "@stripe/stripe-js": "^10.0.0",
        "@stripe/stripe-react-native": "0.64.0",
        "@types/node": "^24.0.0",
        "@types/react": "~19.2.0",
        "react-native": "0.86.3",
        "react-native-svg": "15.15.4"
    }
}
