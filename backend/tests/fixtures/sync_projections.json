  "filters": {
    "business_shared": {
      "with": {
        "member": "SELECT business_id FROM staff WHERE user_id = auth.user_id() AND status = 'active'"
      },
      "where": {
        "clients": [
          "business_id IN member AND deleted_at IS NULL"
        ],
        "subjects": [
          "business_id IN member AND deleted_at IS NULL"
        ],
        "notes": [
          "business_id IN member"
        ],
        "consents": [
          "business_id IN member"
        ],
        "hours": [
          "business_id IN member AND staff_id IS NULL"
        ],
        "items": [
          "business_id IN member"
        ],
        "resources": [
          "business_id IN member"
        ],
        "packages": [
          "business_id IN member"
        ],
        "subscriptions": [
          "business_id IN member"
        ],
        "forms": [
          "business_id IN member"
        ],
        "fields": [
          "business_id IN member"
        ],
        "contracts": [
          "business_id IN member"
        ],
        "files": [
          "business_id IN member"
        ],
        "threads": [
          "business_id IN member"
        ]
      }
    },
    "staff_limited": {
      "with": {
        "limited": "SELECT business_id FROM staff WHERE user_id = auth.user_id() AND status = 'active' AND (role = 'staff' OR role = 'contractor')"
      },
      "where": {
        "businesses": [
          "id IN limited"
        ],
        "staff": [
          "business_id IN limited"
        ],
        "users": [
          "id IN (SELECT user_id FROM staff WHERE business_id IN limited)"
        ],
        "orders": [
          "business_id IN limited AND pickup_status IS NOT NULL"
        ],
        "lines": [
          "business_id IN limited AND for_pickup = true"
        ]
      }
    },
    "staff_self": {
      "with": {
        "own": "SELECT id FROM staff WHERE user_id = auth.user_id() AND status = 'active'"
      },
      "where": {
        "addons": [
          "staff_id IN own"
        ],
        "hours": [
          "staff_id IN own"
        ],
        "recurrences": [
          "staff_id IN own"
        ],
        "accounts": [
          "owner_type = 'staff' AND owner_id IN own"
        ],
        "entries": [
          "owner_type = 'staff' AND owner_id IN own"
        ]
      }
    },
    "business_full": {
      "with": {
        "managed": "SELECT business_id FROM staff WHERE user_id = auth.user_id() AND status = 'active' AND (role = 'owner' OR role = 'admin')"
      },
      "where": {
        "businesses": [
          "id IN managed"
        ],
        "staff": [
          "business_id IN managed"
        ],
        "users": [
          "id IN (SELECT user_id FROM staff WHERE business_id IN managed)"
        ],
        "addons": [
          "business_id IN managed"
        ],
        "hours": [
          "business_id IN managed"
        ],
        "recurrences": [
          "business_id IN managed"
        ],
        "invoices": [
          "business_id IN managed"
        ],
        "estimates": [
          "business_id IN managed"
        ],
        "orders": [
          "business_id IN managed"
        ],
        "lines": [
          "business_id IN managed"
        ],
        "inventory": [
          "business_id IN managed"
        ],
        "payments": [
          "business_id IN managed"
        ],
        "payment_methods": [
          "business_id IN managed"
        ],
        "gift_cards": [
          "business_id IN managed"
        ],
        "accounts": [
          "business_id IN managed"
        ],
        "entries": [
          "business_id IN managed"
        ],
        "review_requests": [
          "business_id IN managed"
        ],
        "broadcasts": [
          "business_id IN managed"
        ],
        "responses": [
          "business_id IN managed"
        ],
        "signatures": [
          "business_id IN managed"
        ]
      }
    },
    "history_shared": {
      "with": {
        "member": "SELECT business_id FROM staff WHERE user_id = auth.user_id() AND status = 'active'"
      },
      "where": {
        "messages": [
          "business_id IN member AND substring(created_at, 1, 7) IN subscription.parameter('months')"
        ]
      }
    },
    "history_self": {
      "with": {
        "own": "SELECT id FROM staff WHERE user_id = auth.user_id() AND status = 'active'"
      },
      "where": {
        "slots": [
          "staff_id IN own AND substring(starts_at, 1, 7) IN subscription.parameter('months')"
        ],
        "bookings": [
          "staff_id IN own AND deleted_at IS NULL AND substring(starts_at, 1, 7) IN subscription.parameter('months')"
        ]
      }
    },
    "history_full": {
      "with": {
        "managed": "SELECT business_id FROM staff WHERE user_id = auth.user_id() AND status = 'active' AND (role = 'owner' OR role = 'admin')"
      },
      "where": {
        "slots": [
          "business_id IN managed AND substring(starts_at, 1, 7) IN subscription.parameter('months')"
        ],
        "bookings": [
          "business_id IN managed AND deleted_at IS NULL AND substring(starts_at, 1, 7) IN subscription.parameter('months')"
        ]
      }
    }
  }
