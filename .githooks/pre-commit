#!/bin/sh
# Pre-commit gate: format-check, lint, generated-code drift and the backend and frontend tests (the
# backend suite needs the local Postgres from `make up`). Browser, device and sync e2e run in CI.
#
# Default a writable uv cache: this machine's ~/.cache/uv can be root-owned, which breaks `uv run`
# from inside a hook. Respects an already-exported UV_CACHE_DIR.
export UV_CACHE_DIR="${UV_CACHE_DIR:-/tmp/uv-cache}"

exec make precommit
