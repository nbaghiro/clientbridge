# Copy to backend/.env. Ports are in the 87xx block (see .docs/engineering.md).

# Core
ENV=dev
DATABASE_URL=postgresql+asyncpg://clientbridge_api:clientbridge_api@localhost:8702/clientbridge
MIGRATION_DATABASE_URL=postgresql+asyncpg://clientbridge_migrator:clientbridge_migrator@localhost:8702/clientbridge
REDIS_URL=redis://localhost:8703/0
# role setup only (scripts/db_access.py); the service superuser, never used by the API
ADMIN_DATABASE_URL=postgresql+asyncpg://clientbridge:clientbridge@localhost:8702/clientbridge
POWERSYNC_SOURCE_PASSWORD=powersync_source
POWERSYNC_STORAGE_PASSWORD=powersync_storage_owner
AUTH_DB_PASSWORD=auth
# Auth service cookie and cipher secrets (the cipher is exactly 32 characters); comma-separate to rotate.
AUTH_COOKIE_SECRET=clientbridge-dev-cookie-secret-do-not-use-in-prod
AUTH_CIPHER_SECRET=clientbridge-dev-cipher-key-0032

# The auth service (Ory Kratos); the admin URL must never be reachable from the internet
AUTH_PUBLIC_URL=http://localhost:8713
AUTH_ADMIN_URL=http://localhost:8714
AUTH_SESSION_COOKIE=cb_session
IDENTITY_CACHE_TTL_SECONDS=30
# Google sign-in through the auth service (read by docker compose); empty leaves the button unconfigured
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Signs dev PowerSync tokens (HS256); must be replaced outside dev
JWT_SECRET=clientbridge-dev-secret-do-not-use-in-prod
JWT_TTL_SECONDS=300

# PowerSync; production signs with RS256 and serves the key at /sync/keys
POWERSYNC_AUDIENCE=powersync
POWERSYNC_KID=clientbridge-dev
POWERSYNC_USE_RS256=false
POWERSYNC_PRIVATE_KEY_PEM=
# JSON map of overlapping verification key IDs to public PEMs; private PEM stays in secret storage.
POWERSYNC_PREVIOUS_PUBLIC_KEYS={}

# Object storage (RustFS in dev, S3 in production)
S3_ENDPOINT=http://localhost:8705
S3_BUCKET=clientbridge
S3_ACCESS_KEY=rustfs
S3_SECRET_KEY=rustfs-dev-secret
S3_REGION=us-east-1
S3_PRESIGN_TTL_SECONDS=3600

# Links and CORS
API_BASE_URL=http://localhost:8701
WEB_BASE_URL=http://localhost:8700
CONNECT_BASE_URL=http://localhost:8709
PAY_BASE_URL=http://localhost:8709
# Connect and Pay origins, served without credentials; only WEB_BASE_URL may send the session cookie.
CORS_ALLOW_ORIGINS=

# Stripe Connect test credentials; account onboarding uses the normal app flow.
# `make stripe-listen` prints the local webhook secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The thin-event destination's secret; locally the same `stripe listen` secret
STRIPE_THIN_WEBHOOK_SECRET=
# The platform endpoint's secret (plan subscriptions); locally the same `stripe listen` secret
STRIPE_PLATFORM_WEBHOOK_SECRET=
# The Billing Portal configuration `scripts.stripe_setup` prints
STRIPE_PORTAL_CONFIGURATION=
STRIPE_CONNECT_COUNTRY=CA
# Our application fee keeps Stripe's percentage plus ours within the ceiling, never above the max
PLATFORM_FEE_CEILING_BPS=320
PLATFORM_FEE_MAX_BPS=200
# Stripe's Canadian percentage rates (stripe.com/en-ca/pricing)
STRIPE_CARD_BPS=290
STRIPE_CARD_PRESENT_BPS=270
STRIPE_ACSS_DEBIT_BPS=100
STRIPE_CONVERSION_BPS=200

# The auth service sends it with each email it hands to the API; read by the API and docker compose
AUTH_EMAIL_HOOK_SECRET=clientbridge-dev-courier-secret-do-not-use-in-prod

# Email, SMS and push; empty values use the console no-op senders.
# EMAIL_FROM must be on a domain verified in Resend; RESEND_WEBHOOK_SECRET signs /webhooks/email.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=
# With ENV=dev mail goes to Mailpit (smtp://localhost:8716) unless SMTP_URL is set. An empty SMTP_URL=
# turns Mailpit off (Resend or the console), so delete that line from an older .env to keep Mailpit.
# SMTP_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
EXPO_ACCESS_TOKEN=
