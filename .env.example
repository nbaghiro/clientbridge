# Copy to backend/.env. Ports are in the 87xx block (see .docs/engineering.md).

# Core
ENV=dev
DATABASE_URL=postgresql+asyncpg://clientbridge:clientbridge@localhost:8702/clientbridge
REDIS_URL=redis://localhost:8703/0
DEV_USER_ID=us_dev

# Auth tokens; JWT_SECRET must be replaced outside dev
JWT_SECRET=clientbridge-dev-secret-do-not-use-in-prod
JWT_ISSUER=clientbridge
JWT_TTL_SECONDS=3600
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
GOOGLE_CLIENT_ID=

# PowerSync; production signs with RS256 and serves the key at /sync/keys
POWERSYNC_AUDIENCE=powersync
POWERSYNC_KID=clientbridge-dev
POWERSYNC_USE_RS256=false
POWERSYNC_PRIVATE_KEY_PEM=

# Object storage (RustFS in dev, S3 in production)
S3_ENDPOINT=http://localhost:8705
S3_BUCKET=clientbridge
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_REGION=us-east-1
S3_PRESIGN_TTL_SECONDS=3600

# Links and CORS
API_BASE_URL=http://localhost:8701
WEB_BASE_URL=http://localhost:8700
CONNECT_BASE_URL=http://localhost:8709
CORS_ALLOW_ORIGINS=

# Stripe Connect; an sk_test key also connects the demo business on seed, and `make stripe-listen` prints the webhook secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_COUNTRY=CA
PLATFORM_FEE_BPS=200

# Inbound webhooks (Interac e-Transfer matching, SMS replies)
INTERAC_WEBHOOK_SECRET=
SMS_WEBHOOK_SECRET=

# Email, SMS and push; empty values use the console no-op senders
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
EXPO_ACCESS_TOKEN=
