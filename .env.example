# Clientbridge claims the 87xx port block so it runs alongside the other ~/Documents/code
# projects. See docs/ports.md.  API 8701 · Web 8700 · Expo 8707.

# ── Backend ──
ENV=dev
DATABASE_URL=postgresql+asyncpg://clientbridge:clientbridge@localhost:8702/clientbridge
JWT_SECRET=clientbridge-dev-secret-do-not-use-in-prod
JWT_ISSUER=clientbridge
JWT_TTL_SECONDS=3600
REDIS_URL=redis://localhost:8703/0

# ── S3 (RustFS dev store, see docker-compose s3) ──
S3_ENDPOINT=http://localhost:8705
S3_BUCKET=clientbridge
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345

# ── Integrations (dev placeholders) ──
# A test-mode key (sk_test_...) also connects the demo business to a verified test account on seed.
STRIPE_SECRET_KEY=
# Printed by `make stripe-listen`, which forwards connected-account events to the local API.
STRIPE_WEBHOOK_SECRET=
INTERAC_API_KEY=
TWILIO_AUTH_TOKEN=
# Email: set both to send real transactional email via Postmark (else no-op console sender)
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=
