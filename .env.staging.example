# Copy to .env.staging (gitignored) and fill in; `make infra-providers ENV=staging` creates the rest.
# Resend: a full-access key (resend.com > API Keys); used here only to create the staging domain,
# a sending-only key for it and the webhook, and never stored in the cluster.
RESEND_ADMIN_API_KEY=
# Stripe sandbox (dashboard.stripe.com, test mode > Developers > API keys), and the Stripe CLI
# profile logged in to that sandbox (`stripe login --project-name <profile>`)
STRIPE_SECRET_KEY=sk_test_
STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_CLI_PROFILE=
# Twilio console > Account info; the script buys and wires a Canadian number
TWILIO_ACCOUNT_SID=AC
TWILIO_AUTH_TOKEN=
# Google Cloud console > APIs & Services > Credentials > OAuth client ID (Web application), with the
# redirect URI https://api.staging.clientbridge.ca/auth/self-service/methods/oidc/callback/google
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# expo.dev > clientbridge-ca > Settings > Access tokens, two robots. EXPO_ACCESS_TOKEN goes to the
# cluster and only sends push, so give its robot the lowest role; EAS_ROBOT_TOKEN, with the Developer
# role, builds, submits and publishes updates from the deploy workflow (`make infra-mobile`) and never
# reaches the cluster, since it could ship code to every installed app
EXPO_ACCESS_TOKEN=
EAS_ROBOT_TOKEN=
# Apple, once the developer account exists (`make infra-mobile` waits on iOS until then):
# the team id (developer.apple.com > Membership), an App Store Connect team API key with the Admin
# role (App Store Connect > Users and Access > Integrations), and an APNs key (developer.apple.com >
# Certificates, IDs & Profiles > Keys, with Apple Push Notifications service). Apple shows each .p8 once.
APPLE_TEAM_ID=
ASC_API_KEY_ID=
ASC_API_ISSUER_ID=
ASC_API_KEY_PATH=
APNS_KEY_ID=
APNS_KEY_PATH=
# INDIVIDUAL for a personal developer account; the default is COMPANY_OR_ORGANIZATION
APPLE_TEAM_TYPE=
