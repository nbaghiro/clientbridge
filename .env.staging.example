# Copy to .env.staging (gitignored) and fill in; `make infra-providers ENV=staging` creates the rest.
# Resend: a full-access key (resend.com > API Keys); used here only to create the staging domain,
# a sending-only key for it and the webhook, and never stored in the cluster.
RESEND_ADMIN_API_KEY=
# Stripe sandbox (dashboard.stripe.com, test mode > Developers > API keys), and the Stripe CLI
# profile logged in to that sandbox (`stripe login --project-name <profile>`)
STRIPE_SECRET_KEY=sk_test_
STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_CLI_PROFILE=
# Twilio console > Account info; the script buys and wires a Canadian number
TWILIO_ACCOUNT_SID=AC
TWILIO_AUTH_TOKEN=
# Google Cloud console > APIs & Services > Credentials > OAuth client ID (Web application), with the
# redirect URI https://api.staging.clientbridge.ca/auth/self-service/methods/oidc/callback/google
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# expo.dev > Account settings > Access tokens
EXPO_ACCESS_TOKEN=
